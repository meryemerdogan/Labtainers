# slow-scan lab: keep sources, configs, docs and test fixtures; drop build/run output.

# Test fixtures ARE needed (the root .gitignore ignores *.log, so re-include them)
!tests/fixtures/*.log

# Labtainers build artifacts (regenerated by rebuild)
*/home_tar/
*/sys_tar/
*.tar
*.tar.gz

# Python caches / test runs
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Runtime output from manual runs (logs outside the fixtures folder, captures)
/*.log
*.pcap
*.pcapng

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
