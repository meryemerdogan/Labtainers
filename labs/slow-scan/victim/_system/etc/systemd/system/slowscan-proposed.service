[Unit]
Description=slow-scan proposed detector (12 ports in 600 s, >= 70% failed)
After=waitparam.service slowscan-monitor.service

[Service]
Type=simple
# Threshold 12 is fixed for Milestone 2; it becomes THRESHOLD in Milestone 3.
ExecStart=/usr/bin/python3 /usr/bin/detector.py --mode proposed --threshold 12 --window 600 --fail-ratio 0.70 --follow /var/log/slowscan/conn.log --out /var/log/slowscan/proposed.log --heartbeat 30
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
