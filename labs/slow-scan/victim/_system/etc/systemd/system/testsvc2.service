[Unit]
Description=slow-scan test service 2 (backup, port 9090)
After=waitparam.service network.target

[Service]
Type=simple
# Port 9090 is fixed for Milestone 2; it becomes TEST_PORT2 in Milestone 3.
ExecStart=/usr/bin/python3 /usr/bin/testsvc.py 9090 backup
User=nobody
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
